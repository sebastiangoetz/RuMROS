/**
 * This aspect implements the nested state of robots and groups.
 * Groups have an aggregated state, that is computed in a bottom-up
 * manner from the contained robot states.
 */
aspect State {
    // Additional constructor without parameters
    public State.State(int id, String name, double speedFactor, double angleTolerance) {
        state().enterConstruction();
        setid(id);
        setname(name);
        setspeedFactor(speedFactor);
        setangleTolerance(angleTolerance);
        setChild(new JastAddList<Parameter>(), 0);
        state().exitConstruction();
    }

    // Additional constructor without parameters and Gazebo-related
    // speedFactor and angleTolerance
    public State.State(int id, String name) {
        state().enterConstruction();
        setid(id);
        setname(name);
        setspeedFactor(0.0);
        setangleTolerance(0.0);
        setChild(new JastAddList<Parameter>(), 0);
        state().exitConstruction();
    }

    public void SwarmGroup.setCurrentState(State s) {
        for (SwarmUnit unit : this.getSwarmUnits()) {
            unit.setCurrentState(s); // Top-down change, no divergent state possible
        }

        this.setCosmeticState(s);
        // Top-down change is the only way to set the aggregated state
        // so there is no divergent state possible
        this.setAggregatedState(s); 

        // Recursively call on nested groups
        for (SwarmGroup group : this.getSwarmGroups()) {
            group.setCurrentState(s);
        }

        // Handle possible divergent state of parent
        SwarmGroup parent = getParentGroup();
        if (parent != null && s.getid() != parent.getCosmeticState().getid()) {
            parent.setDivergentRecursive();
        }
    }

    // Includes logic to also set parent group state to the
    // divergent state if the new state is different from the
    // current aggregated state. This update will only be
    // propagated upwards and contained SwarmUnits will not
    // receive behavior messages since this requires a call
    // to setCurrentState() instead.
    public void SwarmUnit.setStateSafely(State s) {
        setCurrentState(s);
        SwarmGroup parent = getParentGroup();
        if (parent != null && s.getid() != parent.getCosmeticState().getid()) {
            parent.setDivergentRecursive();
        }
    }

    // Sets this group and all parents to the divergent state
    public void SwarmGroup.setDivergentRecursive() {
        setCosmeticState(getStateWithName("divergent"));
        SwarmGroup parent = getParentGroup();
        if (parent != null) {
            parent.setDivergentRecursive();
        }
    }

    // Check divergent state for group recursively and removes
    // divergent label if all units share the same state
    public void SwarmGroup.unsetDivergentRecursive() {
        State groupState = getCurrentState();

        if (getCosmeticState().getid() != getStateWithName("divergent").getid()) {
            return; // Not divergent, no action required
        }

        // Probe divergent state
        for (SwarmUnit unit : getSwarmUnits()) {
            // If any unit has a different state than the group's aggregated state
            // make no changes
            if (unit.getCurrentState().getid() != groupState.getid()) {
                return;
            }
        } 
        // Unset divergent state and propagate upwards
        setCosmeticState(groupState);
        SwarmGroup parent = getParentGroup();
        if (parent != null) {
            parent.unsetDivergentRecursive();
        }
    }

    public void SwarmGroup.addAndSyncSwarmUnit(SwarmUnit u) {
        this.addSwarmUnit(u);

        // Sync the unit's state upon adding to the group
        State s = this.getCosmeticState();
        u.setCurrentState(s); // Top-down change, no divergent state possible
    }
}