  <library_effects>
    <effect id="Material_001-effect">
      <profile_COMMON>
        <newparam sid="mossy_rock_diff_4k_jpg-surface">
          <surface type="2D">
            <init_from>mossy_rock_diff_4k_jpg</init_from>
          </surface>
        </newparam>
        <newparam sid="mossy_rock_diff_4k_jpg-sampler">
          <sampler2D>
            <source>mossy_rock_diff_4k_jpg-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="mossy_rock_diff_4k_jpg-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_images>
