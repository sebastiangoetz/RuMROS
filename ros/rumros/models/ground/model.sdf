<?xml version="1.0" ?>
<sdf version="1.10">
  <model name="ground">
    <static>true</static>
    <link name="ground_link">
      <visual name="ground_visual">
        <geometry>
          <mesh>
            <uri>model://ground/meshes/rocky_ground.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="ground_collision">
        <geometry>
          <plane>
            <size>20 20</size>
          </plane>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>