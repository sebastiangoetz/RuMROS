<?xml version="1.0"?>
<sdf version="1.10">
  <model name="wall_4m">
    <static>true</static>
    <link name="wall_link">
      <visual name="wall_visual">
        <geometry>
          <mesh>
            <uri>model://wall_4m/meshes/wall_4m.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name="wall_collision">
        <pose>0 0 1 0 0 0</pose>
        <geometry>
          <box>
            <size>4 0.2 2</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>